# Omit DATABASE_URL for single-process local PGlite. Production uses PostgreSQL.
DATABASE_URL=
# Runtime path MUST be outside OneDrive. Defaults to local application data.
ET_DATA_DIR=
RESEARCH_PACKAGE_DIR=./UAP_Research_Consolidated_v08
# Local private access is allowed only in development on loopback.
# For production, generate separate strong tokens; never expose them to browser bundles.
ADMIN_TOKEN=
EDITOR_TOKEN=
READER_TOKEN=
CRON_TOKEN=
# Optional grounded model synthesis; disabled without a key. Imported text remains local unless opted in.
OPENAI_API_KEY=
OPENAI_MODEL=
ALLOW_PRIVATE_AI=false
APP_URL=http://127.0.0.1:3000
# In-process ingestion scheduler (src/instrumentation.ts). Set ET_SCHEDULER=off when a separate worker runs.
ET_SCHEDULER=
ET_SCHEDULER_MINUTES=15
# Optional Python analytical service (analytics/service.py) for Fisher, bootstrap CIs and power.
ANALYTICS_URL=
ANALYTICS_TOKEN=
